{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Junkstronaut playtest report",
  "description": "The Playtester's output: measured behaviour compared against what the params claim, plus a candidate value set. Evidence and a proposal — it never gates a run, because the GDD (§3.2) sends a Playtester's failure to the human rather than back around the loop as a code fix.",
  "type": "object",
  "required": ["agent", "verdict", "summary", "findings", "confidence_notes"],
  "additionalProperties": false,
  "properties": {
    "agent": { "const": "playtester" },
    "verdict": { "enum": ["targets_met", "targets_missed", "error"] },
    "summary": { "type": "string", "minLength": 10 },
    "findings": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "gdd_ref", "claim", "measured", "severity", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "gdd_ref": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 10 },
          "measured": { "type": "string", "minLength": 10 },
          "severity": { "enum": ["blocking", "significant", "minor"] },
          "kind": {
            "description": "tuning = grid configurations exist that satisfy this target, so it is a numbers problem. design = almost none do, so the rule itself has to change.",
            "enum": ["tuning", "design"]
          }
        }
      }
    },
    "proposed_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "proposed", "reason"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_0-9]+)+$" },
          "current": {},
          "proposed": {},
          "reason": { "type": "string", "minLength": 10 }
        }
      }
    },
    "confidence_notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 10 }
    }
  }
}
